# ===========================================
# Reservas Pousada - Production Environment
# ===========================================

# PostgreSQL Database
POSTGRES_USER=reservas
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=reservas_pousada

# Better Auth (OBRIGATORIO)
# Gere com: openssl rand -base64 32
# O servidor NAO SOBE sem esta variavel.
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32

# Cifra de CPF - LGPD (OBRIGATORIO)
# Gere com: openssl rand -hex 32   (64 caracteres hexadecimais)
#
# O servidor NAO SOBE sem esta variavel, de proposito: antes, subir sem ela
# fazia o sistema funcionar normalmente e gravar TODOS os CPFs em TEXTO PURO,
# sem erro e sem log.
#
# ATENCAO: esta chave protege a coluna `cpf` (AES-256-GCM) E gera o `cpf_hash`
# (HMAC-SHA256) usado na busca por CPF exato. Perde-la torna os CPFs ilegiveis;
# troca-la exige re-cifrar e re-hashear a base inteira. Guarde uma copia FORA do
# backup do banco — backup e chave no mesmo lugar nao protegem de nada.
CPF_ENCRYPTION_KEY=

# Google OAuth (opcional - deixe vazio para desabilitar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (opcional - emails vao para o console se vazio)
RESEND_API_KEY=
# Remetente (dominio verificado no Resend, com SPF/DKIM/DMARC) e caixa que
# recebe as respostas dos clientes.
EMAIL_FROM=Diária <noreply@pgdev.com.br>
EMAIL_REPLY_TO=

# ===========================================
# Billing (Stripe) — opcional ate o lancamento comercial
# ===========================================
# Interruptor. Com 'false' (ou ausente) NENHUM limite de plano e aplicado.
BILLING_ENABLED=false

# Chaves do Stripe. Comece com as de TESTE (sk_test_ / whsec_).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Ids de Price criados no dashboard do Stripe (Produtos -> Precos).
# Plano sem Price definido simplesmente nao aparece para contratacao.
STRIPE_PRICE_ESSENCIAL_MENSAL=
STRIPE_PRICE_ESSENCIAL_ANUAL=
STRIPE_PRICE_POUSADA_MENSAL=
STRIPE_PRICE_POUSADA_ANUAL=
STRIPE_PRICE_REDE_MENSAL=
STRIPE_PRICE_REDE_ANUAL=

# ===========================================
# Painel de margem (admin)
# ===========================================
# Emails que enxergam /admin/margem, separados por virgula.
# Vazio = ninguem entra. Segredo nao configurado nunca significa "libera geral".
ADMIN_EMAILS=

# Custo fixo mensal de infraestrutura, em centavos, rateado entre os clientes
# pagantes. Ex: 10000 = R$ 100,00/mes. 0 = nao configurado (o painel avisa).
CUSTO_INFRA_MENSAL_CENTAVOS=0

# Pool do Postgres (opcional). A central-db e compartilhada: some o DB_POOL_MAX
# de todas as replicas da API e confira que cabe no max_connections do banco.
# DB_POOL_MAX=10
# DB_POOL_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=15000

# Sentry (opcional). Vazio = nada e enviado e o SDK nem e carregado.
# So erros 5xx e falhas do processo/navegador; sem corpo, cookies ou usuario.
SENTRY_DSN=

# Fila de jobs (pg-boss, schema 'pgboss' no mesmo banco). Desligar so em
# emergencia: os e-mails passam a sair na hora, sem retentativa.
# FILA_HABILITADA=true
# FILA_POOL_MAX=3

# Contadores de rate limit: no Postgres por padrao (compartilhados entre
# replicas e preservados entre deploys). 'memory' so para testes/instancia unica.
# RATE_LIMIT_STORE=postgres

# Fuso da operacao (opcional, padrao America/Sao_Paulo)
# Define o que o sistema considera "hoje" para check-in, dashboard e ocupacao.
# O container roda em UTC; sem isto o dia virava as 21h de Brasilia.
APP_TIMEZONE=America/Sao_Paulo

# ===========================================
# NAO EDITE ABAIXO (definido no docker-compose.yml)
# ===========================================
# - DATABASE_URL        (montado a partir das POSTGRES_*)
# - BETTER_AUTH_URL     https://api.diaria.pgdev.com.br
# - CORS_ORIGIN         lista separada por virgula (hosts novo + antigo)
# - APP_URL             https://diaria.pgdev.com.br (canonico, usado nos links)
# - NEXT_PUBLIC_API_URL (build arg do frontend)

# ===========================================
# Frontend — embutidos no BUILD da imagem (NEXT_PUBLIC_*)
# ===========================================
# Dados da empresa para Privacidade/Termos. Enquanto vazios, as paginas
# mostram "[a definir]" de proposito. Revise os textos com um advogado.
NEXT_PUBLIC_EMPRESA_RAZAO_SOCIAL=
NEXT_PUBLIC_EMPRESA_CNPJ=
NEXT_PUBLIC_EMPRESA_ENDERECO=
NEXT_PUBLIC_EMPRESA_FORO=
NEXT_PUBLIC_CONTATO_EMAIL=
NEXT_PUBLIC_PRIVACIDADE_EMAIL=
NEXT_PUBLIC_ENCARREGADO_NOME=

# Medicao (so carrega depois do consentimento do visitante)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# 'false' esconde o botao "Continuar com Google" (sem GOOGLE_CLIENT_ID no backend)
NEXT_PUBLIC_GOOGLE_LOGIN=
